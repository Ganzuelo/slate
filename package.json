{
  "name": "slate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local desktop Markdown workspace without a community plugin runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ganzuelo/slate.git"
  },
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node scripts/start-desktop.mjs",
    "browser": "node server.mjs --open",
    "test": "node --test",
    "build:editor": "node scripts/build-editor.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:app-icon": "electron scripts/build-app-icon.mjs",
    "build:whiteboard": "node scripts/build-whiteboard.mjs"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "electron@44.10.0": true
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@excalidraw/excalidraw": "0.18.1",
    "@lezer/highlight": "1.2.5",
    "lucide": "1.64.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "lodash-es": "^4.17.24",
    "katex": "^0.18.2",
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    }
  }
}
